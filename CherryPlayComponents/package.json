{
  "name": "@cherryplay/components",
  "version": "0.6.4",
  "description": "Shared React components for CherryPlay playlist display",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-css.mjs",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "playlist",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "luxon": "^3.4.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@cherryplay/eslint-config": "file:../eslint-config-cherryplay",
    "@testing-library/react": "^16.3.0",
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.0.3"
    },
    "flatted": "^3.4.0",
    "picomatch": "^4.0.4"
  }
}
