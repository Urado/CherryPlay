# =============================================================================
# =============================================================================
# CherryPlay — пример для локальной разработки (.env.development)
# Скопируйте в .env.development и при необходимости измените значения.
# =============================================================================

# Deploy (для docker-compose при локальной сборке)
VERSION=latest
REGISTRY=ghcr.io
IMAGE_NAME_SERVER=owner/repo/server
IMAGE_NAME_WEB=owner/repo/web

# PostgreSQL (локальный Docker)
POSTGRES_DB=cherryplay
POSTGRES_USER=cherryplay
POSTGRES_PASSWORD=cherryplay_password

# pgAdmin (локальный)
PGADMIN_EMAIL=admin@cherryplay.com
PGADMIN_PASSWORD=admin

# Backend — JWT (dev-секрет, не использовать в продакшене)
JWT_SECRET_KEY=dev-secret-key-minimum-32-characters-long-change-in-production
JWT_ISSUER=CherryPlayServer
JWT_AUDIENCE=CherryPlayClient
OAUTH_REDIRECT_BASE_URL=http://localhost:5000

# OAuth (заглушки для локальной разработки)
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_MAILRU_CLIENT_ID=
OAUTH_MAILRU_CLIENT_SECRET=
OAUTH_TELEGRAM_BOT_TOKEN=

# CORS (localhost для Vite и web)
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://web:80

# Frontend — URL бэкенда при dev
VITE_API_URL=http://localhost:5000
VITE_SIGNALR_URL=http://localhost:5000/partyHub
