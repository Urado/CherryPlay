# =============================================================================
# CherryPlay — единый пример переменных окружения (бэкенд, фронт, БД, деплой)
# Скопируйте в .env или .env.development / .env.production и заполните значения.
# Полное описание переменных: см. ENV.md в корне репозитория.
# =============================================================================

# -----------------------------------------------------------------------------
# Deploy / Docker Compose (скрипт deploy.sh, docker-compose.prod.yml)
# -----------------------------------------------------------------------------
VERSION=latest
REGISTRY=ghcr.io
IMAGE_NAME_SERVER=owner/repo/server
IMAGE_NAME_WEB=owner/repo/web
# GHCR_TOKEN — для логина в GitHub Container Registry (deploy.sh); задаётся в CI/GitHub Secrets, не в .env

# -----------------------------------------------------------------------------
# PostgreSQL (контейнер postgres)
# -----------------------------------------------------------------------------
POSTGRES_DB=cherryplay
POSTGRES_USER=cherryplay
POSTGRES_PASSWORD=your_postgres_password

# -----------------------------------------------------------------------------
# pgAdmin (контейнер pgadmin)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# -----------------------------------------------------------------------------
# Backend (CherryPlayServer) — JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-long-change-in-production
JWT_ISSUER=CherryPlayServer
JWT_AUDIENCE=CherryPlayClient

# -----------------------------------------------------------------------------
# Backend — OAuth redirect (базовый URL для callback)
# -----------------------------------------------------------------------------
OAUTH_REDIRECT_BASE_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Backend — OAuth VK
# -----------------------------------------------------------------------------
OAUTH_VK_CLIENT_ID=your_vk_client_id
OAUTH_VK_CLIENT_SECRET=your_vk_client_secret

# -----------------------------------------------------------------------------
# Backend — OAuth Mail.ru
# -----------------------------------------------------------------------------
OAUTH_MAILRU_CLIENT_ID=your_mailru_client_id
OAUTH_MAILRU_CLIENT_SECRET=your_mailru_client_secret

# -----------------------------------------------------------------------------
# Backend — OAuth Telegram
# -----------------------------------------------------------------------------
OAUTH_TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# -----------------------------------------------------------------------------
# Backend — Password reset / RuSender email
# -----------------------------------------------------------------------------
RUSENDER_API_TOKEN=
RUSENDER_SEND_KEY_ID=
EMAIL_FROM_ADDRESS=noreply@cherrypashkaparty.ru
EMAIL_FROM_NAME=CherryPlay
PUBLIC_WEB_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend — строка подключения к БД (для локального запуска без Docker)
# В Docker передаётся через ConnectionStrings__DefaultConnection
# -----------------------------------------------------------------------------
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=cherryplay;Username=cherryplay;Password=your_postgres_password

# -----------------------------------------------------------------------------
# Backend — CORS (разрешённые origins; в Docker как CORS_ORIGIN_0, CORS_ORIGIN_1, CORS_ORIGIN_2)
# -----------------------------------------------------------------------------
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://web:80

# -----------------------------------------------------------------------------
# Frontend (CherryPlayWeb) — Vite подставляет при сборке (префикс VITE_)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
# VITE_SIGNALR_URL — опционально; если не задан, SignalR использует VITE_API_URL
VITE_SIGNALR_URL=http://localhost:5000/partyHub
