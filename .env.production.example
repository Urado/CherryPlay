# =============================================================================
# CherryPlay — пример для продакшена (.env.production)
# НЕ КОММИТИТЬ реальный .env.production с секретами!
# На сервере: создайте .env.production вручную или используйте GitHub Secrets;
# deploy.sh подставляет секреты из CI при деплое.
# GHCR_TOKEN для deploy.sh задаётся в GitHub Actions (secrets), не в этом файле.
# =============================================================================

VERSION=1.0.0
REGISTRY=ghcr.io
IMAGE_NAME_SERVER=owner/repo/server
IMAGE_NAME_WEB=owner/repo/web

# PostgreSQL — задать надёжный пароль (или через GitHub Secret POSTGRES_PASSWORD)
POSTGRES_DB=cherryplay
POSTGRES_USER=cherryplay
POSTGRES_PASSWORD=set_via_github_secret_or_env

# pgAdmin — задать свои учётные данные
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=set_via_github_secret

# Backend — JWT: обязательно свой секрет не короче 32 символов (GitHub Secret JWT_SECRET_KEY)
JWT_SECRET_KEY=set_via_github_secret_minimum_32_chars
JWT_ISSUER=CherryPlayServer
JWT_AUDIENCE=CherryPlayClient
OAUTH_REDIRECT_BASE_URL=https://yourdomain.com

# OAuth — реальные ключи приложений (GitHub Secrets OAUTH_VK_CLIENT_ID / OAUTH_VK_CLIENT_SECRET)
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_MAILRU_CLIENT_ID=
OAUTH_MAILRU_CLIENT_SECRET=
OAUTH_TELEGRAM_BOT_TOKEN=

# CORS — разрешённые origins для продакшена (GitHub Secrets CORS_ORIGIN_0, CORS_ORIGIN_1, CORS_ORIGIN_2)
CORS_ORIGIN_0=https://yourdomain.com
CORS_ORIGIN_1=https://www.yourdomain.com
CORS_ORIGIN_2=http://web:80

# Frontend: в продакшене часто используют относительные пути (nginx); при необходимости задайте:
# VITE_API_URL=
# VITE_SIGNALR_URL=
