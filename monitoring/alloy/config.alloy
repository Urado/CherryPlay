local.file_match "docker_logs" {
  path_targets = [{
    __path__ = "/var/lib/docker/containers/*/*.log",
    job = "docker",
  }]
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_logs.receiver]
}

loki.process "docker_logs" {
  stage.docker {}
  stage.replace {
    expression = "(?i)([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})"
    replace    = "[REDACTED_EMAIL]"
  }
  stage.replace {
    expression = "(?i)([?&][A-Z0-9_.-]+=[^&\\\" ]+)"
    replace    = "[REDACTED_QUERY]"
  }
  stage.replace {
    expression = "(?i)(client: [0-9a-f:.]+)"
    replace    = "client: [REDACTED_IP]"
  }
  stage.replace {
    expression = "([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})"
    replace    = "[REDACTED_IP]"
  }
  stage.label_drop {
    values = ["filename", "container_id"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
