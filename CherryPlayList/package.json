{
  "name": "cherryplaylist",
  "version": "0.5.1",
  "description": "Desktop application for creating and managing music playlists",
  "main": "dist-electron/electron/main.mjs",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation concurrently -k \"vite\" \"wait-on http-get://localhost:5173/src/index.tsx && npm run compile:electron && electron .\"",
    "dev:web": "cross-env VITE_APP_MODE=demo vite",
    "dev:web:project": "cross-env VITE_APP_MODE=demo VITE_LOAD_DEMO_PROJECT=1 vite",
    "dev:web:live": "cross-env VITE_APP_MODE=demo VITE_DEMO_LIVE=1 vite",
    "dev:capacitor": "cross-env VITE_APP_MODE=capacitor vite",
    "compile:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-preload.mjs && node -e \"const fs=require('fs');const p='dist-electron/electron/main.js';if(fs.existsSync(p)){fs.renameSync(p,'dist-electron/electron/main.mjs')}const pkg='dist-electron/electron/package.json';if(!fs.existsSync(pkg)){fs.writeFileSync(pkg,'{\\\"type\\\":\\\"module\\\"}\\n')}\"",
    "build": "cross-env NODE_OPTIONS=--no-deprecation vite build",
    "build:electron": "npm run compile:electron && npm run build",
    "electron:dev": "electron .",
    "preview": "vite preview",
    "test": "jest",
    "test:unit": "jest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run stylelint && npm run format:check",
    "prepare": "node scripts/prepare-husky.mjs",
    "dist": "npm run build:electron && electron-builder",
    "stage:aimp-plugin": "node scripts/stage-aimp-plugin.mjs",
    "dist:win": "npm run build:electron && npm run stage:aimp-plugin && electron-builder --win --x64",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "dist:all": "npm run build:electron && electron-builder --win --mac --linux"
  },
  "keywords": [
    "electron",
    "react",
    "playlist",
    "music"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cherryplay/components": "file:../CherryPlayComponents",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "^10.0.0",
    "@mui/icons-material": "^6.0.0",
    "localforage": "^1.10.0",
    "music-metadata": "^11.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-sync-external-store": "^1.4.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-eslint": "^1.8.1",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@cherryplay/components": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.cherryplaylist.app",
    "productName": "CherryPlayList",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "serverConfig.production.json",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "plugins/example-plugin",
        "to": "plugins/example-plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "plugins/CherryPlayAimpBridge",
        "to": "CherryPlayAimpBridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CherryPlayList"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "publish": null
  }
}
