{
  "name": "cherry-play-web",
  "version": "0.6.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cherryplay/components": "file:../CherryPlayComponents",
    "@microsoft/signalr": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cherryplay/eslint-config": "file:../eslint-config-cherryplay",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-testing-library": "^7.16.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
