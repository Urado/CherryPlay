{
  "name": "cherry-play-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "lint": "node scripts/eslint-wrapper.js . --max-warnings=10",
    "lint:fix": "node scripts/eslint-wrapper.js . --fix",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=10 --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cherryplay/components": "file:../CherryPlayComponents",
    "@microsoft/signalr": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
